Main.Py:-

import os
import json
from scripts.log_parser import parse_logs
from scripts.analyzer import analyze_log
from config import INPUT_LOG, OUTPUT_FILE

def main():
    os.makedirs("output", exist_ok=True)

    logs = parse_logs(INPUT_LOG)

    if not logs:
        print("No important logs found!")
        return

    results = []

    for i, log in enumerate(logs):
        print(f"Processing {i+1}/{len(logs)}")

        analysis = analyze_log(log)

        results.append({
            "log": log,
            "analysis": analysis
        })

    with open(OUTPUT_FILE, "w") as f:
        json.dump(results, f, indent=4)

    print(" Analysis completed! Check output/report.json")

if __name__ == "__main__":
    main()

