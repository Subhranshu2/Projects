Scripts/Analyzer.Py
import json
from scripts.api_client import call_llm

def analyze_log(log_text):
    prompt = f"""
    Analyze the log and return ONLY valid JSON:

    {{
        "type": "",
        "severity": "Low/Medium/High",
        "issue": "",
        "suggestion": ""
    }}

    Log: {log_text}
    """

    response = call_llm(prompt)

    try:
        return json.loads(response)
    except:
        return {
            "type": "Unknown",
            "severity": "Unknown",
            "issue": log_text,
            "suggestion": "LLM response parsing failed"
        }

