Main.Py:-
from scripts.file_utils import read_json, write_json, setup_logger
from scripts.annotator import annotate_text
from config import INPUT_FILE, OUTPUT_FILE
import logging

def process():
    setup_logger()
    data = read_json(INPUT_FILE)

    results = []

    for item in data:
        text = item.get("text", "")
        logging.info(f"Processing: {text}")

        annotation = annotate_text(text)

        results.append({
            "text": text,
            "annotation": annotation
        })

    write_json(OUTPUT_FILE, results)
    print(" Annotation completed!")

if __name__ == "__main__":
    process()

